# NexGuard AI environment variables
# Copy this file and fill in your own keys. NEVER commit real keys to git.

# Licence profile. This is a free demo (Premium is demo-only, no payments), so
# keep "noncommercial". Switch to "commercial" only if you start charging, and
# then add GOOGLE_WEB_RISK_API_KEY. See backend/deployment_profile.py.
NEXGUARD_DEPLOYMENT_PROFILE=noncommercial
# Google Web Risk (required only in the commercial profile)
GOOGLE_WEB_RISK_API_KEY=

# VirusTotal (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=

# Optional extra API integrations
GOOGLE_SAFEBROWSING_API_KEY=
# urlscan.io key — enables live sandbox page previews + screenshots in reports
# (Premium-only intel). Get one free at https://urlscan.io/user/profile/
URLSCAN_API_KEY=
# URLHaus auth key (optional) — https://urlhaus.abuse.ch/api/
URLHAUS_AUTH_KEY=

# --- Auth / accounts ---------------------------------------------------------
# Strong random secret used to sign JWTs. If unset, a random one is generated
# on each start (sessions won't survive a restart). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Passwords for the auto-seeded admin@nexguard.local / superadmin@nexguard.local
# accounts created on first startup. If unset, random passwords are printed once
# to the server console — set these to keep stable credentials.
ADMIN_PASSWORD=
SUPERADMIN_PASSWORD=

# Comma-separated allowed CORS origins for production, e.g.
# NEXGUARD_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
NEXGUARD_ALLOWED_ORIGINS=

# Voice transcription toggles (optional)
NEXGUARD_ENABLE_ONLINE_STT=0
NEXGUARD_ENABLE_WHISPER=0
# Whisper model size when NEXGUARD_ENABLE_WHISPER=1 ("small" handles Hindi well)
NEXGUARD_WHISPER_MODEL=small

# --- Support ticket email notifications (optional) ---------------------------
# When set, a NEW support ticket is emailed to NEXGUARD_SUPPORT_TO from the
# tool's own mail account. The owner's address is NEVER shown on the website.
# Tickets always appear in the admin Support inbox even without this. For a
# Gmail sender, create an App Password (Google Account -> Security -> App
# passwords) and use it as NEXGUARD_SMTP_PASSWORD.
NEXGUARD_SMTP_HOST=
NEXGUARD_SMTP_PORT=587
NEXGUARD_SMTP_USER=
NEXGUARD_SMTP_PASSWORD=
NEXGUARD_SMTP_FROM=
NEXGUARD_SUPPORT_TO=

# --- Real Claude AI for the support bot (optional, costs money) --------------
# Without a key the FREE built-in FAQ bot answers (zero cost). With a key,
# questions the FAQ can't match get a natural Claude answer grounded in the
# FAQ. Requires:  pip install anthropic   Get a key: https://platform.claude.com
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-4-8)
NEXGUARD_CLAUDE_MODEL=

# --- Free offline AI for the support bot (Ollama) ---------------------------
# Zero-cost alternative to ANTHROPIC_API_KEY: install Ollama (ollama.com),
# `ollama pull qwen2.5:7b`, then set the model name below. If both this and
# ANTHROPIC_API_KEY are set, Claude answers first and Ollama is the backup.
NEXGUARD_OLLAMA_MODEL=
# Optional: non-default Ollama server
NEXGUARD_OLLAMA_URL=

# --- Telegram bot (optional) -------------------------------------------------
# All scan tools over Telegram: send the bot a link / photo (QR or screenshot)
# / voice note / .eml file and it answers with the real engine's verdict.
# 1) In Telegram talk to @BotFather -> /newbot -> copy the token here
# 2) Start the backend, then run:  cd backend && py telegram_bot.py
# More than one bot? Comma-separate the tokens — they all run together.
NEXGUARD_TELEGRAM_TOKEN=
# Optional: sign the bot's scans into an account (higher daily scan limit)
NEXGUARD_BOT_EMAIL=
NEXGUARD_BOT_PASSWORD=
# Optional: point the bot at a non-local backend
NEXGUARD_BACKEND_URL=

# --- Stripe billing (TEST MODE ONLY) -----------------------------------------
# TEST keys: https://dashboard.stripe.com/test/apikeys  (sk_test_... / pk_test_...)
# Webhook secret (whsec_...): run `stripe listen --forward-to localhost:8000/billing/webhook`
# Leave blank to disable billing — the admin-approval upgrade flow still works.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: reuse a recurring Price id; else a $9.99/mo TEST price is auto-created.
STRIPE_PRICE_ID=
# Where Checkout returns to (used if the request has no Origin header)
NEXGUARD_FRONTEND_URL=http://localhost:5500

# --- AI image detector (free, local) -----------------------------------------
# Hugging Face model for the AI-vs-real probability layer. Downloads once
# (~300 MB) on first use. Set to "off" to disable the classifier layer —
# metadata proof + visual cues keep working, verdicts just say UNCERTAIN
# more often. Default: the benchmark winner in backend/image_origin.py.
NEXGUARD_IMAGE_MODEL=
